# Sentry project DSN. Without it the SDK runs disabled and the app is unchanged.
SENTRY_DSN=

# Optional deployment metadata.
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=

# Tracing switch. > 0 enables the Flue gen_ai span hierarchy (workflow -> agent
# -> model -> tool). 0 keeps errors + logs only. Lower non-AI traffic in
# production with a tracesSampler.
SENTRY_TRACES_SAMPLE_RATE=1.0

# Content capture (prompts, model output, tool values). Opt in only after
# approving a data policy — these export user content, likely PII.
SENTRY_AI_RECORD_INPUTS=false
SENTRY_AI_RECORD_OUTPUTS=false

# Provider key for the example agent (anthropic/claude-haiku-4-5).
ANTHROPIC_API_KEY=
